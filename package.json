{
  "name": "squadbeyond-clone",
  "version": "0.1.0",
  "description": "SquadBeyond 完全再現クローン（社内限定・非公開）",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "mock": "tsx mock-server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "tsx tools/verify/index.ts",
    "capture-plan": "tsx tools/capture-plan/build.ts",
    "traceability": "tsx tools/traceability/build.ts",
    "gate": "tsx tools/gate/grep-gate.ts",
    "rehydrate": "tsx tools/rehydrate/build.ts",
    "copy-snippet": "cat tools/capture-console/snippet.js | pbcopy && echo \"採取スニペットをクリップボードにコピーしました。Chrome の DevTools > Console に Cmd+V で貼り付けて Enter を押してください。\"",
    "fetch-assets": "tsx tools/capture-assets/fetch.ts",
    "coverage": "tsx tools/coverage/report.ts",
    "scrub": "tsx tools/scrub/index.ts && tsx tools/scrub/index.ts --in ~/squadbeyond-capture-quarantine/assets --out capture/clean/assets"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "express": "^5.2.1",
    "quill": "^2.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
